---
import { illustration } from '../lib/illustrations.mjs'
import { LEVELS } from '../lib/modules.mjs'

interface Props {
	slug: string
	href: string
	index: number
	title: string
	summary: string
	level: 'must' | 'good' | 'skip'
	illus: string
}
const { slug, href, index, title, summary, level, illus } = Astro.props
const lvl = LEVELS[level]
---

<article class="note-card card" data-card={slug}>
	<a class="panel note-art" href={href} tabindex="-1" aria-hidden="true" set:html={illustration(illus)} />
	<div class="note-body">
		<div class="note-meta">
			<span class="note-num">{String(index).padStart(2, '0')}</span>
			<span class="note-pills">
				<span class="pill read-pill" hidden>✓ Read</span>
				<span class="pill"><span class={`lvl ${lvl.className}`}></span>{lvl.label}</span>
			</span>
		</div>
		<h3><a href={href}>{title}</a></h3>
		<p>{summary}</p>
		<a class="btn" href={href}>Read</a>
	</div>
</article>

<style>
	.note-card {
		display: flex;
		flex-direction: column;
		padding: 14px;
		transition: transform 0.15s ease;
	}

	.note-card:hover {
		border-color: var(--plum);
	}

	.note-art {
		display: block;
		aspect-ratio: 240 / 150;
		overflow: hidden;
	}

	.note-art :global(svg) {
		display: block;
		width: 100%;
		height: 100%;
	}

	.note-body {
		display: flex;
		flex-direction: column;
		flex: 1;
		padding: 16px 6px 6px;
	}

	.note-meta {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 10px;
	}

	.note-num {
		font: 500 12.5px var(--mono);
		color: var(--muted);
	}

	h3 {
		font-size: clamp(21px, 2.3vw, 25px);
		margin-bottom: 10px;
	}

	h3 a {
		text-decoration: none;
	}

	p {
		margin: 0 0 18px;
		font-size: 14.5px;
		line-height: 1.6;
		color: var(--muted);
		flex: 1;
	}

	.btn {
		align-self: flex-start;
	}
</style>
