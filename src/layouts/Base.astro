---
import '../styles/global.css'
import '../styles/prose.css'
import '../styles/diagrams.css'
import '../styles/print.css'

interface Props {
	title: string
	description?: string
}
const { title, description = 'How React works under the hood: fiber, reconciliation, the work loop, commit, scheduling and hooks.' } = Astro.props
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<link rel="icon" href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}favicon.svg`} type="image/svg+xml" />
		<title>{title}</title>
	</head>
	<body>
		<slot />
		<footer class="site-foot wrap">
			Built from the <em>React Internals</em> notes in the Nexus vault · checked against the React 19.2.5 source.
		</footer>
		<script src="../scripts/client.ts"></script>
	</body>
</html>
