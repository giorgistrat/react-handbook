---
// Old React Internals URLs (/notes/<slug>/) → /internals/<slug>/
import { NOTES } from '../../lib/notes/internals.mjs'

export function getStaticPaths() {
	return NOTES.map((n) => ({ params: { slug: n.slug } }))
}

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/')
const to = `${base}internals/${Astro.params.slug}/`
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<title>Moved</title>
		<meta name="robots" content="noindex" />
		<link rel="canonical" href={to} />
		<meta http-equiv="refresh" content={`0; url=${to}`} />
		<script is:inline define:vars={{ to }}>location.replace(to + location.hash)</script>
	</head>
	<body><a href={to}>This note moved here.</a></body>
</html>
