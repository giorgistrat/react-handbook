---
import { getCollection } from 'astro:content'
import Base from '../layouts/Base.astro'
import NoteCard from '../components/NoteCard.astro'
import { pipeline } from '../lib/diagrams.mjs'
import moc from '../lib/moc-intro.json'

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/')
const notes = (await getCollection('notes')).sort((a, b) => a.data.order - b.data.order)
const hrefFor = (slug: string) => `${base}notes/${slug}/`
const intro = moc.introHtml.replace(/href="notes\//g, `href="${base}notes/`)
---

<Base title="React Internals">
	<header class="intro wrap">
		<p class="eyebrow">Sheet set · React 19.2.5</p>
		<h1>React Internals</h1>
		<p class="tagline">How React actually works under the hood…kinda deep.</p>
		<div class="lead" set:html={intro} />
		<div class="btn-row">
			<a class="btn" href={hrefFor('start-here')}>Start reading</a>
			<a class="btn btn-ghost" href="#notes">All notes</a>
			<a class="btn btn-ghost" href={hrefFor('engine-map')}>Lost in function names? Engine map</a>
		</div>
	</header>

	<section class="wrap section">
		<h2>The pipeline</h2>
		<Fragment set:html={pipeline({ hrefFor })} />
	</section>

	<section class="wrap section" id="notes">
		<h2>The notes</h2>
		<p class="section-sub">Read them in order. Each one builds on the ones before it. <span class="read-progress" data-read-progress hidden></span></p>
		<div class="grid">
			{notes.map((n, i) => (
				<NoteCard
					slug={n.data.slug}
					href={hrefFor(n.data.slug)}
					index={i}
					title={n.data.title.replace('React Internals - ', '')}
					summary={n.data.summary}
					level={n.data.level}
					illus={n.data.illus}
				/>
			))}
		</div>
	</section>
</Base>

<style>
	.intro {
		padding-top: clamp(64px, 8vw, 88px);
		padding-bottom: 12px;
		max-width: 880px;
		margin-left: max(0px, calc((100% - 1120px) / 2));
	}

	.eyebrow {
		display: inline-block;
		margin: 0 0 18px;
		padding: 3px 10px;
		border: 1px solid var(--accent);
		border-radius: 2px;
		color: var(--accent);
		font: 500 12.5px var(--mono);
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	h1 {
		font-size: clamp(42px, 8vw, 92px);
		letter-spacing: -0.06em;
		line-height: 0.95;
	}

	.tagline {
		margin: 14px 0 22px;
		font-size: clamp(18px, 2.3vw, 24px);
		font-weight: 600;
		letter-spacing: -0.02em;
		color: var(--ink-soft);
	}

	.lead :global(p) {
		margin: 0 0 14px;
		font-size: 17px;
		max-width: 70ch;
	}

	.lead :global(code) {
		color: var(--accent);
		padding: 0 2px;
	}

	.lead :global(.callout) {
		padding: 12px 16px;
		background: var(--cream);
		border: 1.5px solid var(--line);
		border-radius: var(--radius);
	}

	.lead :global(a) {
		font-weight: 700;
		text-decoration-color: var(--accent);
		text-decoration-thickness: 2px;
	}

	.btn-row {
		margin-top: 22px;
	}

	.section {
		padding-top: clamp(48px, 7vw, 80px);
	}

	.section h2 {
		font-size: clamp(28px, 4vw, 40px);
		text-align: center;
		margin-bottom: 10px;
	}

	.section-sub {
		text-align: center;
		margin: 0 0 32px;
		color: var(--ink-soft);
	}

	.section :global(.fig-pipeline) {
		margin-top: 28px;
		background: var(--cream);
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(300px, 100%), 1fr));
		gap: 28px 22px;
	}
</style>
